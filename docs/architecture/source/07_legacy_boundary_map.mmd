        A4 --> A5[calibration-only threshold selection]
        A5 --> A6[untouched test evaluation]
        A6 --> A7[reports/model_validation/]
        A7 --> A8[artifact/model.pkl and artifact/preprocessor.pkl]
    end
    subgraph legacy["Legacy Scaffolding (retained, disclaimed, not CR-3 evidence)"]
        L1[src/components/model_trainer.py]
        L2[src/utils.py Optuna helper]
        L3[src/pipeline/predict_pipeline.py]
        L4[static/]
        L5[Legacy requirements entries: xgboost, catboost, optuna, Flask, gunicorn]
    end
